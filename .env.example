# Backend API base URL
# Development: http://localhost:8000
# Production: https://api.complivibe.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Web3Forms access key. Get a free key at https://web3forms.com; submissions run
# client-side from the browser. Set the real key in .env.local — never commit it.
#
# NO LONGER USED by the Book a Demo or waitlist forms. Those now submit straight
# to the CMS (POST /cms-api/leads, see NEXT_PUBLIC_CMS_API_URL below), which
# stores each lead and surfaces it under /admin/leads. Web3Forms was an external
# dependency doing a job the CMS already does, and with no key configured it only
# produced a confusing error on an otherwise valid submission.
#
# Still read by two forms, which is why the key is still here:
#   - src/app/score/ScoreApp.tsx            (compliance score report request)
#   - src/app/resources/ResourcesSubscribeForm.tsx  (resources subscribe)
# Leave this unset and those two will show "Form is not configured yet".
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# CompliVibe CMS API base URL, including the /cms-api prefix.
#
# Read at request time from the browser, so it must be NEXT_PUBLIC_ (inlined
# into the client bundle at build time). Two callers:
#   - The /admin panel, which reads and writes content and leads live.
#   - The public Book a Demo and waitlist forms, whose only destination is the
#     unauthenticated POST /cms-api/leads endpoint (see src/lib/submitLead.ts).
#     If this is wrong or the CMS is down, those forms fail visibly — there is
#     no second delivery path behind them.
#
# This is separate from CMS_API_URL, the un-prefixed, build-time-only variable
# that scripts/fetch-content.ts uses to compile content into the site.
#
# Development: http://127.0.0.1:4000/cms-api
#              Cross-origin from the dev server, so the CMS's CORS_ORIGINS must
#              list the frontend origin (e.g. http://localhost:3000).
# Production:  /cms-api
#              Relative, i.e. same-origin through the nginx proxy — no CORS.
NEXT_PUBLIC_CMS_API_URL=http://127.0.0.1:4000/cms-api

# Base the CMS serves uploaded images from, i.e. wherever GET /uploads/<file>
# lives. Optional — leave unset unless the CMS serves its API and its uploads
# from different places.
#
# Cover images uploaded through /admin are stored on the CMS's filesystem and
# are saved as CMS-relative paths ("/uploads/mgk3f1x9-4c1b.png"). This site is a
# static export on its own domain, so src/lib/media.ts puts this base in front
# of any coverImage starting with /uploads/ — and leaves everything else alone,
# which is why paths under public/ and pasted external URLs keep working.
#
# Unset, it is derived from NEXT_PUBLIC_CMS_API_URL with the trailing /cms-api
# stripped, which is already right for both deployments:
#   Development: http://127.0.0.1:4000/cms-api -> http://127.0.0.1:4000
#                => absolute, cross-origin to the CMS dev server.
#   Production:  /cms-api                      -> "" (empty)
#                => "/uploads/…" stays relative and is served same-origin by
#                   the nginx `location /uploads/` block. Nothing to set.
#
# Set it explicitly only if uploads move elsewhere — a CDN or an S3 bucket, say:
#   NEXT_PUBLIC_CMS_MEDIA_URL=https://cdn.complivibe.in
#
# NEXT_PUBLIC_ because it is inlined at build time and read on public pages.
NEXT_PUBLIC_CMS_MEDIA_URL=

# ---------------------------------------------------------------------------
# Build-time only — read by scripts/fetch-content.ts, which runs on `prebuild`
# (and on demand via `npm run fetch:content`). None of these are NEXT_PUBLIC_,
# so none reach the browser: the script compiles CMS content into static
# modules under src/content/ and the shipped site never calls the CMS.
# ---------------------------------------------------------------------------

# CMS API base URL for the build-time fetch, including the /cms-api prefix.
# The build machine talks to the CMS directly, so this is usually an internal
# address rather than the public one in NEXT_PUBLIC_CMS_API_URL above.
# Trailing slashes are stripped. Optional — defaults to the value below.
CMS_API_URL=http://127.0.0.1:4000/cms-api

# Optional bearer token, sent on every build-time request.
# Not needed for a normal build: the fetch only ever asks for PUBLISHED
# content, which the CMS serves anonymously. Set it only if your CMS
# deployment also requires auth for published reads.
CMS_API_TOKEN=

# Set to exactly "true" to downgrade a CMS outage from fatal to a warning:
# the script writes empty content modules and lets the build finish, so the
# site ships with no posts, articles or FAQs rather than failing.
# Anything else (including unset) fails the build instead — the default,
# because a silently empty blog is worse than a red build.
CMS_FETCH_OPTIONAL=
