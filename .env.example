# Backend API base URL
# Development: http://localhost:8000
# Production: https://api.complivibe.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Web3Forms access key (used by the Waitlist and Book a Demo forms).
# Get a free key at https://web3forms.com. Submissions run client-side from the
# browser. Set the real key in .env.local — never commit it.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# CompliVibe CMS API base URL, including the /cms-api prefix.
#
# Used ONLY by the /admin panel, which reads and writes content live from the
# browser — so it must be NEXT_PUBLIC_ (inlined into the client bundle at build
# time). This is separate from CMS_API_URL, the un-prefixed, build-time-only
# variable that scripts/fetch-content.ts uses to compile content into the site.
#
# Development: http://127.0.0.1:4000/cms-api
#              Cross-origin from the dev server, so the CMS's CORS_ORIGINS must
#              list the frontend origin (e.g. http://localhost:3000).
# Production:  /cms-api
#              Relative, i.e. same-origin through the nginx proxy — no CORS.
NEXT_PUBLIC_CMS_API_URL=http://127.0.0.1:4000/cms-api
